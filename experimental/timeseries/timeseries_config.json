{
  "configuration_file": "gs://ssb-tip-tutorials-data-produkt-test/metstat/konfigurasjon/ssb_timeseries/timeseries_config.json",
  "io_handlers": {
    "simple-parquet": {
      "handler": "ssb_timeseries.io.pyarrow_simple.FileSystem",
      "options": {}
    },
    "hive-partitioned-parquet": {
      "handler": "ssb_timeseries.io.pyarrow_hive.FileSystem",
      "options": {}
    },
    "json": {
      "handler": "ssb_timeseries.io.json_metadata.JsonMetaIO",
      "options": {}
    },
    "snapshots": {
      "handler": "ssb_timeseries.io.snapshots.FileSystem",
      "options": {}
    }
  },
  "repositories": {
    "metstat": {
      "name": "metstat",
      "directory": {
        "handler": "simple-parquet",
        "options": {
          "path": "/buckets/produkt/metstat/timeseries"
        }
      },
      "catalog": {
        "handler": "json",
        "options": {
          "path": "/buckets/produkt/metstat/timeseries/metadata"
        }
      }
    }
  },
  "snapshots": {
    "default": {
      "directory": {
        "options": {
          "path": "/buckets/produkt/metstat/timeseries/snapshots"
        },
        "handler": "snapshot"
      }
    }
  },
  "logging": {
    "version": 1,
    "disable_existing_loggers": false,
    "handlers": {
      "console": {
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout",
        "level": "INFO"
      }
    },
    "loggers": {
      "ssb_timeseries": {
        "level": "INFO",
        "handlers": [
          "console"
        ],
        "propagate": false
      }
    }
  }
}